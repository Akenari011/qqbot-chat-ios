# Required on the server only; never put QQ platform credentials in the iOS app.
QQBOT_APP_ID=your-app-id
QQBOT_CLIENT_SECRET=replace-with-rotated-secret
QQBOT_GATEWAY_KEY=generate-a-long-random-secret
QQBOT_CHAT_SCENE=c2c
QQBOT_CHAT_TARGET_ID=authorized-user-openid
QQBOT_DB_PATH=/var/lib/qqbot-chat/messages.sqlite3
QQBOT_INTERNAL_INGEST_URL=https://your-domain.example/internal/qqbot/incoming
QQBOT_GATEWAY_URL=https://your-domain.example
